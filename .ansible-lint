---
# Profile is deliberately not the strictest: `production` demands things this
# repo has decided against, notably fully-qualified names for every builtin
# and a changed_when on every command. Both are already followed where they
# matter; enforcing them everywhere would add noise, not correctness.
profile: moderate

exclude_paths:
  - .github/
  - chezmoi/

skip_list:
  # This repo targets one machine it also runs on. A name for the play and
  # every task is enforced; naming the *hosts* pattern is not useful here.
  - name[play]

warn_list:
  - experimental
