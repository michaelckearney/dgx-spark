# Hermes config for the `sysadmin` profile. Managed by the dgx-spark repo
# (roles/hermes_profiles) — rendered over
# ~/.hermes/profiles/sysadmin/config.yaml on every ./setup.sh.
# Edit profiles/sysadmin/config.yaml.j2, not the rendered copy.

# The llama-swap gateway. Because llama-swap is a service that holds the port
# and loads models on demand, this endpoint answers whether or not a model is
# resident — so the profile is reachable without anything being started first.
# Keep in step with llama_swap_listen in inventory/group_vars/all/main.yml.
model:
  default: "nvidia/Qwen3.6-35B-A3B-NVFP4"
  # "vllm" is an alias for "custom" (see cli-config.yaml.example in the Hermes
  # source). Spelled this way because it is what the endpoint actually serves.
  provider: "vllm"
  base_url: "http://{{ llama_swap_listen }}/v1"

skills:
  # Repo-managed documentation, read in place rather than copied in.
  #
  # External dirs are read-only to Hermes: skill creation always writes to the
  # profile's own skills/, sync_skills() skips anything an external dir already
  # provides, and the curator only prunes skills it created itself. So these
  # coexist with bundled skills and with whatever this agent learns, and none
  # of the three can clobber another.
  #
  # Templated because the path depends on where this repo is checked out.
  # Hermes silently ignores a path that does not exist — if skills stop
  # appearing, check this resolves before looking anywhere else.
  external_dirs:
    - "{{ hermes_profiles_source }}/sysadmin/skills"

# The approvals block is NOT documented in Hermes' cli-config.yaml.example.
# The schema comes from _get_approval_config() / _get_approval_mode() in
# tools/approval.py: mode is one of manual | smart | off, timeout is seconds.
#
# `manual` is a review step, not a security control. This profile changes the
# machine, and the point of it is that those changes end up in this repo
# correctly — so you want to see them happen.
#
# Not `smart`: that mode asks an auxiliary LLM to risk-assess each flagged
# command, and on this box that request goes to the same llama-swap gateway as
# the real work — queueing behind it or swapping the loaded model.
#
# Note deny rules are matched against the command string, so they stop the
# direct form and not a script that contains the same command. These two exist
# to keep the mode above from being turned off at launch, which is the one
# bypass that would make everything else here moot.
approvals:
  mode: manual
  timeout: 300
  deny:
    - "*--yolo*"
    - "*HERMES_YOLO_MODE*"
    # SOUL.md says commit but never push. A deny rule makes that structural
    # rather than a matter of the model following instructions, and deny is
    # checked before every bypass — so it holds even if approvals are turned
    # off. Pushing is the only step in the loop that leaves this machine.
    - "*git push*"

  # The one command this profile exists to run. Allowlisting it exactly means
  # a converge needs no human, while everything else still stops for one.
  #
  # The allowlist is checked before the single-query deny below, which is what
  # makes `hermes -p sysadmin -q "..."` work end to end: setup.sh runs, and
  # anything unexpected fails closed instead of hanging on a prompt nobody can
  # answer.
  #
  # Entries never match a command containing shell operators, so this cannot be
  # chained past with `./setup.sh; something-else`.
  command_allowlist:
    - "./setup.sh"
    - "./setup.sh --check"

  # Non-interactive one-shot sessions (-q), which is how `harbor` reaches this
  # profile. `deny` rather than `approve`: anything outside the allowlist above
  # fails immediately instead of waiting out the 300s timeout, and a failure
  # that says "this needed approval" is a far better outcome than an agent
  # quietly granted root because nobody was watching.
  single_query_mode: deny
